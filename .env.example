# Copie este arquivo para .env e preencha.
# O .env NÃO vai para o GitHub (está no .gitignore).

PORT=3000

# --- Opção 1: banco online (Neon, Supabase...) ---
# Cole aqui a connection string do serviço. Se preenchida, ela é usada
# e as variáveis do banco local abaixo são ignoradas.
DATABASE_URL=

# --- Opção 2: banco local ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=sua_senha_aqui
DB_NAME=komanda
