{
  "name": "komanda-backend",
  "version": "0.1.0",
  "description": "API do Komanda - sistema de gestão para lancheria com delivery",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.test.json",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:push": "prisma db push",
    "test:integration": "npm run build && node scripts/test-mongo.cjs"
  },
  "keywords": [],
  "author": "Anna Hermes, Diego Silva, Gabriel Lessa, Lucas Sol",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/supertest": "^7.2.1",
    "prisma": "6.19.3",
    "supertest": "^7.3.1",
    "tsx": "4.23.15",
    "typescript": "^5.9.2",
    "vitest": "5.0.5"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2"
  }
}
