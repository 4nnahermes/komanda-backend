generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url = env("DATABASE_URL")
}

model Contador {
  chave String @id @map("_id")
  valor Int
  @@map("contadores")
}

enum TipoCategoria {
  ALIMENTO
  BEBIDA
}

model Categoria {
  id Int @id @map("_id")
  nome String
  nomeNormalizado String @unique
  ordem Int
  ativo Boolean @default(true)
  // ALIMENTO tem acompanhamentos e adicionais; BEBIDA tem opções (sabores, marcas).
  // Ausente em categorias antigas: vale como ALIMENTO.
  tipo TipoCategoria?
  // Base que vale para todos os produtos da categoria.
  ingredientes String[]
  adicionais Adicional[]
  opcoes String[]
  produtos Produto[]
  @@index([ordem, id])
  @@map("categorias")
}

type Adicional {
  nome String
  precoCentavos BigInt
}

model Produto {
  id Int @id @map("_id")
  nome String
  nomeNormalizado String
  descricao String?
  precoCentavos BigInt
  ativo Boolean @default(true)
  categoriaId Int
  categoria Categoria @relation(fields: [categoriaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ingredientes String[]
  adicionais Adicional[]
  opcoes String[]
  @@unique([categoriaId, nomeNormalizado])
  @@index([ativo, categoriaId])
  @@map("produtos")
}

model Bairro {
  id Int @id @map("_id")
  nome String
  nomeNormalizado String @unique
  taxaEntregaCentavos BigInt
  ativo Boolean @default(true)
  @@index([nome, id])
  @@map("bairros")
}

model Motoboy {
  id Int @id @map("_id")
  nome String
  nomeNormalizado String @unique
  telefone String?
  valorFixoNoiteCentavos BigInt
  ativo Boolean @default(true)
  @@index([nome, id])
  @@map("motoboys")
}

enum TipoPedido {
  ENTREGA
  RETIRADA
}

enum StatusPedido {
  EM_PREPARO
  PRONTO
  ENTREGUE
  CANCELADO
}

enum FormaPagamento {
  PIX
  CREDITO
  DEBITO
  DINHEIRO
  FIADO
}

// Cópia de id e nome no momento do pedido. Renomear o bairro ou o motoboy
// depois não altera pedidos antigos.
type ReferenciaPedido {
  id Int
  nome String
}

type AdicionalItemPedido {
  nome String
  precoCentavos BigInt
}

// Nome e preços copiados do cardápio no momento da venda (RN5).
type ItemPedido {
  produtoId Int
  nome String
  quantidade Int
  precoUnitarioCentavos BigInt
  ingredientesRetirados String[]
  adicionais AdicionalItemPedido[]
  // Opções escolhidas de uma bebida; cada uma é uma unidade.
  opcoes String[]
}

model Pedido {
  id Int @id @map("_id")
  // Reinicia a cada noite de operação.
  numero Int
  // AAAA-MM-DD; a noite vira às 06:00 de Brasília.
  noite String
  criadoEm DateTime
  tipo TipoPedido
  status StatusPedido
  nomeCliente String
  telefone String?
  bairro ReferenciaPedido?
  endereco String?
  itens ItemPedido[]
  taxaEntregaCentavos BigInt
  formaPagamento FormaPagamento
  valorRecebidoCentavos BigInt?
  motoboy ReferenciaPedido?
  // Tempo de espera (min) informado quando o pedido foi criado. Null em pedidos antigos.
  prazoMinutos Int?
  @@unique([noite, numero])
  @@index([noite, status])
  @@map("pedidos")
}
